{
  "$schema": "https://github.com/toeverything/affine/releases/latest/download/config.schema.json",
  "storages": {
    "avatar.storage": {
      "provider": "aws-s3",
      "bucket": "replace-with-backblaze-bucket-name",
      "config": {
        "endpoint": "https://s3.replace-with-region.backblazeb2.com",
        "region": "replace-with-region",
        "forcePathStyle": true,
        "credentials": {
          "accessKeyId": "replace-with-backblaze-key-id",
          "secretAccessKey": "replace-with-backblaze-application-key"
        }
      }
    },
    "blob.storage": {
      "provider": "aws-s3",
      "bucket": "replace-with-backblaze-bucket-name",
      "config": {
        "endpoint": "https://s3.replace-with-region.backblazeb2.com",
        "region": "replace-with-region",
        "forcePathStyle": true,
        "credentials": {
          "accessKeyId": "replace-with-backblaze-key-id",
          "secretAccessKey": "replace-with-backblaze-application-key"
        }
      }
    }
  }
}
